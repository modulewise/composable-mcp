package composable:mcp@0.3.0;

interface types {
    /// JSON Schema as string.
    type json-schema = string;

    /// JSON value as string.
    type json-value = string;

    /// Audience role for content annotations.
    enum role {
        user,
        assistant,
    }

    /// Optional annotations for content blocks and resources.
    record annotations {
        /// Intended audience(s) for the data.
        audience: option<list<role>>,
        /// Importance from 0.0 (least) to 1.0 (most).
        priority: option<f64>,
        /// ISO 8601 last-modified timestamp.
        last-modified: option<string>,
    }

    /// Hints describing expected tool behavior.
    record tool-annotations {
        /// Human-readable display name (precedence: tool.title > annotations.title > tool.name).
        title: option<string>,
        /// If true, the server claims the tool does not modify its environment.
        read-only-hint: option<bool>,
        /// If true, the server claims the tool may perform destructive updates.
        destructive-hint: option<bool>,
        /// If true, the server claims repeated calls with the same arguments have no additional effect.
        idempotent-hint: option<bool>,
        /// If true, the server claims the tool may interact with external entities.
        open-world-hint: option<bool>,
    }

    record tool {
        name: string,
        description: option<string>,
        title: option<string>,
        /// JSON Schema defining input parameters.
        input-schema: json-schema,
        /// Optional JSON Schema for output validation.
        output-schema: option<json-schema>,
        annotations: option<tool-annotations>,
        meta: option<list<meta-entry>>,
    }

    record text-content {
        text: string,
        annotations: option<annotations>,
        meta: option<list<meta-entry>>,
    }

    record image-content {
        /// base64 encoded
        data: string,
        mime-type: string,
        annotations: option<annotations>,
        meta: option<list<meta-entry>>,
    }

    record audio-content {
        /// base64 encoded
        data: string,
        mime-type: string,
        annotations: option<annotations>,
        meta: option<list<meta-entry>>,
    }

    record resource-link {
        uri: string,
        name: option<string>,
        description: option<string>,
        mime-type: option<string>,
        annotations: option<annotations>,
        meta: option<list<meta-entry>>,
    }

    record text-resource-contents {
        uri: string,
        mime-type: option<string>,
        text: string,
        meta: option<list<meta-entry>>,
    }

    record blob-resource-contents {
        uri: string,
        mime-type: option<string>,
        blob: string,
        meta: option<list<meta-entry>>,
    }

    variant resource-contents {
        text(text-resource-contents),
        blob(blob-resource-contents),
    }

    record embedded-resource {
        resource-data: resource-contents,
        annotations: option<annotations>,
        meta: option<list<meta-entry>>,
    }

    variant content-block {
        text(text-content),
        image(image-content),
        audio(audio-content),
        resource-link(resource-link),
        %resource(embedded-resource),
    }

    record call-tool-result {
        content: list<content-block>,
        is-error: bool,
        /// Optional structured content conforming to tool's output-schema.
        structured-content: option<string>,
        meta: option<list<meta-entry>>,
    }

    /// Metadata key-value pair (_meta in MCP spec).
    /// Keys may include: traceparent, tracestate, etc.
    type meta-entry = tuple<string, string>;

    /// MCP Implementation info (clientInfo / serverInfo).
    record implementation {
        name: string,
        version: string,
        title: option<string>,
    }

    /// Request params for initialization.
    record initialize-request {
        protocol-version: option<string>,
        /// JSON-encoded ClientCapabilities
        capabilities: option<json-value>,
        client-info: option<implementation>,
        meta: option<list<meta-entry>>,
    }

    /// Result of initialization. Carries the active session-id plus the
    /// server's negotiated protocol version, capabilities, identifying info,
    /// and optional usage instructions.
    record initialize-result {
        session-id: string,
        protocol-version: string,
        /// JSON-encoded ServerCapabilities
        capabilities: json-value,
        server-info: implementation,
        instructions: option<string>,
        meta: option<list<meta-entry>>,
    }

    /// Request params for tools/call.
    record call-tool-request {
        name: string,
        arguments: option<json-value>,
        meta: option<list<meta-entry>>,
    }

    /// Request params for tools/list.
    record list-tools-request {
        cursor: option<string>,
        meta: option<list<meta-entry>>,
    }

    /// Result from tools/list. Includes a continuation cursor when the
    /// server has more tools beyond this page (absent on the final page).
    record list-tools-result {
        tools: list<tool>,
        next-cursor: option<string>,
        meta: option<list<meta-entry>>,
    }

    /// JSON-RPC error object returned by the server. Distinct from a tool
    /// execution error (which is reported inside a successful call-tool-result
    /// with `is-error: true`) and from a transport failure (which is returned
    /// via the WIT `result<..., string>` outer error).
    record response-error {
        code: s32,
        message: string,
        /// Optional JSON-encoded server-supplied error detail.
        data: option<json-value>,
    }

    /// Payload of an initialize JSON-RPC response: result or error.
    variant initialize-payload {
        %result(initialize-result),
        error(response-error),
    }

    /// Payload of a tools/list JSON-RPC response: result or error.
    variant list-tools-payload {
        %result(list-tools-result),
        error(response-error),
    }

    /// Payload of a tools/call JSON-RPC response: result or error.
    variant call-tool-payload {
        %result(call-tool-result),
        error(response-error),
    }

    /// JSON-RPC envelope for initialize.
    record initialize-response {
        id: s32,
        payload: initialize-payload,
    }

    /// JSON-RPC envelope for tools/list.
    record list-tools-response {
        id: s32,
        payload: list-tools-payload,
    }

    /// JSON-RPC envelope for tools/call.
    record call-tool-response {
        id: s32,
        payload: call-tool-payload,
    }
}

interface client {
    use types.{initialize-request, initialize-response, list-tools-request, list-tools-response, call-tool-request, call-tool-response};

    /// An active MCP session. Encapsulates the connection state (server URL,
    /// session id, negotiated protocol version, monotonic request-id counter).
    /// Call `close` to terminate the session on the server (a best-effort HTTP
    /// DELETE).
    ///
    /// There are three error layers:
    /// - Transport failure: returned via the `result<..., string>` error arm.
    /// - JSON-RPC protocol error: returned in the response payload as an
    ///   `error` variant (but see comment on the `initialize` constructor).
    /// - Tool execution error (only for tools/call): protocol succeeded, but
    ///   the tool itself reported `is-error: true` inside its result.
    resource session {
        /// Initialize a connection to an MCP server. Returns a session handle
        /// on success. A JSON-RPC protocol error during initialize is treated
        /// as failure (no session is created) and returned via the outer Err.
        initialize: static async func(server-url: string, request: option<initialize-request>) -> result<session, string>;

        /// Return the JSON-RPC response from the initialize call. The payload
        /// should always be the `result` variant in practice, since a proper
        /// constructor would have returned Err on a JSON-RPC error response.
        initialize-response: func() -> initialize-response;

        /// List available tools from the MCP server.
        list-tools: async func(request: option<list-tools-request>) -> result<list-tools-response, string>;

        /// Call a tool.
        call-tool: async func(request: call-tool-request) -> result<call-tool-response, string>;

        /// Terminate the session on the server (best-effort HTTP DELETE).
        close: async func();
    }
}

world mcp-client {
    export client;
    import composable:http/client@0.2.0;
    import wasi:logging/logging@0.1.0-draft;
}

world mcp-client-otel-interceptor {
    export client;
    import client;
    import wasi:otel/tracing@0.2.0-rc.2+patch;
    import wasi:otel/types@0.2.0-rc.2+patch;
    import wasi:clocks/wall-clock@0.2.6;
    import wasi:random/random@0.2.6;
}

/// A single named tool on a remote MCP server.
/// The server URL and tool name come from configuration.
world mcp-tool {
    export composable:tools/tool@0.1.0;
    import client;
    import wasi:config/store@0.2.0-rc.1;
}

/// A set of tools on a single remote MCP server.
/// The server URL comes from configuration.
world mcp-toolset {
    export composable:tools/toolset@0.1.0;
    import client;
    import wasi:config/store@0.2.0-rc.1;
}
