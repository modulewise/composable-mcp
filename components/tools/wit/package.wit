package composable:tools@0.2.0;

/// Shared types for tool components.
///
/// Uses the MCP spec's tool model, whether or not a tool is accessed over the
/// MCP protocol. A tool component colocated with a calling agent is therefore
/// consistent with one proxying a remote MCP server on behalf of that agent.
interface types {
    /// A JSON value, as text.
    type json = string;

    /// Metadata key-value pair (`_meta` in the MCP spec). Keys may include
    /// `traceparent`, `tracestate`, and others.
    type meta-entry = tuple<string, string>;

    /// Audience role for content annotations.
    enum role {
        user,
        assistant,
    }

    /// Optional annotations for content blocks and resources.
    record annotations {
        /// Intended audience(s) for the data.
        audience: option<list<role>>,
        /// Importance from 0.0 (least) to 1.0 (most).
        priority: option<f64>,
        /// ISO 8601 last-modified timestamp.
        last-modified: option<string>,
    }

    record text-content {
        text: string,
        annotations: option<annotations>,
        meta: list<meta-entry>,
    }

    record image-content {
        /// base64 encoded
        data: string,
        mime-type: string,
        annotations: option<annotations>,
        meta: list<meta-entry>,
    }

    record audio-content {
        /// base64 encoded
        data: string,
        mime-type: string,
        annotations: option<annotations>,
        meta: list<meta-entry>,
    }

    record resource-link {
        uri: string,
        name: option<string>,
        description: option<string>,
        mime-type: option<string>,
        annotations: option<annotations>,
        meta: list<meta-entry>,
    }

    record text-resource-contents {
        uri: string,
        mime-type: option<string>,
        text: string,
        meta: list<meta-entry>,
    }

    record blob-resource-contents {
        uri: string,
        mime-type: option<string>,
        /// base64 encoded
        blob: string,
        meta: list<meta-entry>,
    }

    variant resource-contents {
        text(text-resource-contents),
        blob(blob-resource-contents),
    }

    record embedded-resource {
        resource-data: resource-contents,
        annotations: option<annotations>,
        meta: list<meta-entry>,
    }

    /// One item of a result's unstructured content.
    variant content-block {
        text(text-content),
        image(image-content),
        audio(audio-content),
        resource-link(resource-link),
        %resource(embedded-resource),
    }

    /// Optional annotations describing expected tool behavior. Mirroring the
    /// MCP ToolAnnotations, these are hints, not guarantees.
    record tool-annotations {
        /// Human-readable display name.
        title: option<string>,
        /// If true, the tool should not modify its environment.
        read-only-hint: option<bool>,
        /// If true, the tool may perform destructive updates.
        destructive-hint: option<bool>,
        /// If true, repeated calls with the same arguments should have no
        /// additional effect.
        idempotent-hint: option<bool>,
        /// If true, the tool may interact with external entities.
        open-world-hint: option<bool>,
    }

    /// Describes a tool for discovery and for presenting to a language model.
    record tool-metadata {
        name: string,
        title: option<string>,
        description: option<string>,
        /// JSON Schema for the tool's input arguments.
        input-schema: json,
        /// Optional JSON Schema for structured output.
        output-schema: option<json>,
        annotations: option<tool-annotations>,
        meta: list<meta-entry>,
    }

    /// A failure to complete a call, as distinct from a tool that ran and
    /// reported failure through `is-error`.
    ///
    /// Codes follow JSON-RPC and the MCP spec, which reserves `-32000` to
    /// `-32019` for implementations. A tool invoked in the same runtime has
    /// no protocol errors to report, so should use `-32000` for any failure.
    record tool-error {
        code: s32,
        message: string,
        data: option<json>,
    }

    /// Which tool to call, its arguments, and any accompanying metadata.
    record call-tool-request {
        name: string,
        /// The arguments object, empty for a tool that takes none.
        arguments: json,
        meta: list<meta-entry>,
    }

    /// The result of one call, with `is-error` indicating how to interpret it.
    record call-tool-result {
        content: list<content-block>,
        is-error: bool,
        /// Structured content conforming to the tool's output schema. Only a
        /// JSON object before the 2026-07-28 spec, which admits any value.
        structured-content: option<json>,
        meta: list<meta-entry>,
    }
}

/// The universal tool interface exported by any tool implementation.
interface tool {
    use types.{tool-metadata, call-tool-result, tool-error, json, meta-entry};

    /// Return the tool's metadata.
    metadata: async func() -> result<tool-metadata, string>;

    /// Call the tool.
    call: async func(
        arguments: json,
        meta: list<meta-entry>,
    ) -> result<call-tool-result, tool-error>;
}

/// A named collection of tools.
interface toolset {
    use types.{tool-metadata, call-tool-request, call-tool-result, tool-error};

    /// List the metadata for every tool in this toolset.
    %list: async func() -> result<list<tool-metadata>, string>;

    /// Call the tool named in the request.
    call: async func(request: call-tool-request) -> result<call-tool-result, tool-error>;
}
